# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/threads-bot.db

# Threads API (register your app at https://developers.facebook.com)
THREADS_APP_ID=your-threads-app-id
THREADS_APP_SECRET=your-threads-app-secret
THREADS_REDIRECT_URI=http://localhost:3000/api/oauth/callback
THREADS_WEBHOOK_VERIFY_TOKEN=any-random-string-you-pick

# Telegram (chat ids are per-user, linked via /api/auth/telegram/link)
TELEGRAM_BOT_TOKEN=your-bot-token-from-@BotFather

# OpenAI
OPENAI_API_KEY=sk-...

# Session JWT (must be at least 16 chars; openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-32-plus-character-string
